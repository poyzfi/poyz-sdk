{
  "name": "poyz-tooling",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace root for the POYZ TypeScript packages: risk-buffer, @poyz/sdk and poyz-cli.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poyzfi/poyz-sdk.git"
  },
  "homepage": "https://poyz.fi",
  "workspaces": [
    "packages/risk-buffer",
    "packages/sdk",
    "packages/cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  }
}
