{
  "name": "@poyz/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the POYZ delta-neutral synthetic dollar on Solana.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poyzfi/poyz-sdk.git"
  },
  "homepage": "https://poyz.fi",
  "bugs": {
    "url": "https://github.com/poyzfi/poyz-sdk/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/index.d.ts",
        "default": "./dist/cjs/index.cjs"
      },
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync-idl": "node scripts/sync-idl.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "example": "node examples/readme-example.mjs",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "solana",
    "delta-neutral",
    "synthetic-dollar",
    "funding-yield",
    "sdk",
    "poyz"
  ],
  "dependencies": {
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@poyz/risk-buffer": "^0.1.0",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
